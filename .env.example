# Copie este arquivo para .env e preencha com os seus valores

# Projeto do Google Cloud usado para rodar as consultas no BigQuery
GCP_PROJECT_ID=seu-projeto-aqui

# Conta de armazenamento ADLS Gen2 na Azure e sua chave de acesso
AZURE_STORAGE_ACCOUNT=sua-conta-aqui
AZURE_STORAGE_KEY=sua-chave-aqui

# Event Hubs (streaming): connection string do namespace e nome do hub
EVENTHUB_CONNECTION_STRING=sua-connection-string-aqui
EVENTHUB_NAME=eventos-indicador
